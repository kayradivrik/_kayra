# Sanity CMS Public Configuration
NEXT_PUBLIC_SANITY_PROJECT_ID=your_project_id_here
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-01-01

# Sanity Write Token (Private - DO NOT COMMIT REAL VALUE)
SANITY_API_WRITE_TOKEN=your_sanity_write_token_here

# Admin Key
ADMIN_SECRET_KEY=your_admin_secret_key_here

# Site URL for canonicals, sitemap and OpenGraph
NEXT_PUBLIC_SITE_URL=https://kayradivrik.github.io

# Google Analytics 4 Measurement ID (Optional, e.g. G-XXXXXXXXXX)
NEXT_PUBLIC_GA_ID=

# Google Search Console Verification (Optional)
NEXT_PUBLIC_GOOGLE_VERIFICATION=
